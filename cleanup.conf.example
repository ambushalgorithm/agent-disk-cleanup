# agent-disk-cleanup configuration
#
# Copy to cleanup.conf (next to install.sh) and edit, or override via the
# environment when running ./install.sh. Values here are used by install.sh to
# render the scheduler units/plists and the runtime environment file.

# Where the user-level scripts are installed.
SCRIPT_DIR="$HOME/bin"

# opencode session retention, in days.
RETENTION_DAYS=2

# Always keep at least this many of the most recent top-level opencode sessions
# PER DIRECTORY (and their sub-sessions), regardless of retention.
KEEP_RECENT_SESSIONS=3

# Idle detection: skip when opencode consumes more than this many CPU centiseconds
# in a CPU_SAMPLE-second window. Idle opencode sits around 20; real work is in the
# hundreds, so 150 avoids false "busy" skips.
CPU_TICKS_MAX=150

# Space reclaim strategy. A full off-root rebuild is used when the freed-page
# count exceeds REBUILD_FREELIST_PAGES or REBUILD_FREELIST_PCT% of the file;
# otherwise up to VACUUM_PAGES_PER_RUN pages are freed per run with
# incremental_vacuum (bounded so the WAL stays small).
REBUILD_FREELIST_PAGES=100000
REBUILD_FREELIST_PCT=25
VACUUM_PAGES_PER_RUN=50000

# Schedule. "DOW-list HH:MM" (e.g. "Mon,Wed,Fri,Sun 04:00" or "daily 04:00").
# Used directly as a systemd OnCalendar expression, and parsed into
# StartCalendarInterval (launchd) / cron fields on other platforms.
SCHEDULE="Mon,Wed,Fri,Sun 04:00"
HOST_SCHEDULE="Mon,Wed,Fri,Sun 04:20"
RANDOMIZED_DELAY=600

# Directory used for the one-time off-root conversion. Leave empty to
# auto-detect a secondary local filesystem; if none exists the conversion
# builds on the database filesystem (safe when free space is ample).
CONVERT_DIR=""

# opencode database path. Leave empty to auto-detect (opencode db path / XDG).
OPENCODE_DB=""

# Set to 1 to let the scheduled job perform the one-time off-root conversion
# (stops opencode when idle, rebuilds the DB in auto_vacuum=INCREMENTAL mode).
CONVERT=0

# Host cleanup toggles. Each is skipped when its tools are unavailable.
ENABLE_DOCKER_PRUNE=1
ENABLE_JOURNALD=1
JOURNAL_MAX_USE="500M"
ENABLE_APT_CLEAN=1
ENABLE_MACOS_CLEANUP=0
